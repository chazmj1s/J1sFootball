<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SaturdayPulse.Models"
             xmlns:controls="clr-namespace:SaturdayPulse.Controls"
             xmlns:converters="clr-namespace:SaturdayPulse.Converters"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             x:Class="SaturdayPulse.Views.PowerRankingsPage"
             x:Name="ThisPage"
             Shell.NavBarIsVisible="False">


  <Grid RowDefinitions="Auto,Auto,*,24">

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ROW 0: Teams | Top 25 | Conferences — mirrors      -->
    <!--        Postseason's Title Games | Playoffs | Bowls  -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Grid Grid.Row="0"
          ColumnDefinitions="*,*,*"
          BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1E1E1E}"
          Padding="8,4">

      <Border Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
        <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding SelectViewCommand}" CommandParameter="Teams" />
        </Border.GestureRecognizers>
        <Label Text="Teams"
               FontSize="14" FontAttributes="Bold">
          <Label.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsTeamsView}" Value="True">
              <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
              <Setter Property="TextDecorations" Value="Underline" />
            </DataTrigger>
            <DataTrigger TargetType="Label" Binding="{Binding IsTeamsView}" Value="False">
              <Setter Property="TextColor" Value="{AppThemeBinding Light=#888888, Dark=#666666}" />
              <Setter Property="TextDecorations" Value="None" />
            </DataTrigger>
          </Label.Triggers>
        </Label>
      </Border>

      <Border Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
        <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding SelectViewCommand}" CommandParameter="Top25" />
        </Border.GestureRecognizers>
        <Label Text="Top 25"
               FontSize="14" FontAttributes="Bold">
          <Label.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsTop25View}" Value="True">
              <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
              <Setter Property="TextDecorations" Value="Underline" />
            </DataTrigger>
            <DataTrigger TargetType="Label" Binding="{Binding IsTop25View}" Value="False">
              <Setter Property="TextColor" Value="{AppThemeBinding Light=#888888, Dark=#666666}" />
              <Setter Property="TextDecorations" Value="None" />
            </DataTrigger>
          </Label.Triggers>
        </Label>
      </Border>

      <Border Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
        <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding SelectViewCommand}" CommandParameter="Conferences" />
        </Border.GestureRecognizers>
        <Label Text="Conferences"
               FontSize="14" FontAttributes="Bold">
          <Label.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsConferencesView}" Value="True">
              <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
              <Setter Property="TextDecorations" Value="Underline" />
            </DataTrigger>
            <DataTrigger TargetType="Label" Binding="{Binding IsConferencesView}" Value="False">
              <Setter Property="TextColor" Value="{AppThemeBinding Light=#888888, Dark=#666666}" />
              <Setter Property="TextDecorations" Value="None" />
            </DataTrigger>
          </Label.Triggers>
        </Label>
      </Border>

    </Grid>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ROW 1a: Team column headers                         -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Grid Grid.Row="1"
          IsVisible="{Binding IsTeamsView}"
          Padding="4,3"
          BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
          ColumnDefinitions="52,22,*,76,54,50,54">

      <Border Grid.Column="0" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding SortColumnCommand}" CommandParameter="Rank"/>
        </Border.GestureRecognizers>
  <Label Text="Rank ↕" FontAttributes="Bold" FontSize="11" LineBreakMode="NoWrap">
        </Label>
</Border>
      <Label Grid.Column="1" Text="" />
      <Border Grid.Column="2" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding SortColumnCommand}" CommandParameter="Team"/>
        </Border.GestureRecognizers>
  <Label Text="Team ↕" FontAttributes="Bold" FontSize="11" LineBreakMode="NoWrap">
        </Label>
</Border>
      <Border Grid.Column="3" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding SortColumnCommand}" CommandParameter="Record"/>
        </Border.GestureRecognizers>
  <Label Text="Record ↕" FontAttributes="Bold" FontSize="11" LineBreakMode="NoWrap">
        </Label>
</Border>
      <Border Grid.Column="4" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding SortColumnCommand}" CommandParameter="Rating"/>
        </Border.GestureRecognizers>
  <Label Text="Rating ↕" FontAttributes="Bold" FontSize="11" LineBreakMode="NoWrap">
        </Label>
</Border>
      <Border Grid.Column="5" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding SortColumnCommand}" CommandParameter="SOS"/>
        </Border.GestureRecognizers>
  <Label Text="SOS ↕" FontAttributes="Bold" FontSize="11" LineBreakMode="NoWrap">
        </Label>
</Border>

      <!-- Roster Rank — now sortable, same pattern as the other headers. -->
      <VerticalStackLayout Grid.Column="6" Spacing="0" HorizontalOptions="Center">
        <VerticalStackLayout.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding SortColumnCommand}" CommandParameter="RosterRank"/>
        </VerticalStackLayout.GestureRecognizers>
        <Label Text="Roster" FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
        <Label Text="Rank ↕" FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
      </VerticalStackLayout>

    </Grid>


    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ROW 1b: Conference column headers                   -->
    <!-- Same SortColumnCommand — the ViewModel routes by    -->
    <!-- IsConferencesView.                                  -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Grid Grid.Row="1"
          IsVisible="{Binding IsConferencesView}"
          Padding="4,3"
          BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
          ColumnDefinitions="52,*,54,50,54">

      <Border Grid.Column="0" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
        <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding SortColumnCommand}" CommandParameter="Rank"/>
        </Border.GestureRecognizers>
        <Label Text="Rank ↕" FontAttributes="Bold" FontSize="11" LineBreakMode="NoWrap" />
      </Border>
      <Border Grid.Column="1" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
        <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding SortColumnCommand}" CommandParameter="Conference"/>
        </Border.GestureRecognizers>
        <Label Text="Conference ↕" FontAttributes="Bold" FontSize="11" LineBreakMode="NoWrap" />
      </Border>
      <!-- Non-sortable caption over the averaged columns to its right -->
      <Label Grid.Column="1" Text="Averages"
             FontAttributes="Bold,Italic" FontSize="11" LineBreakMode="NoWrap"
             HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,6,0"
             TextColor="{AppThemeBinding Light=#99000000, Dark=#99FFFFFF}" />
      <Border Grid.Column="2" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
        <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding SortColumnCommand}" CommandParameter="Rating"/>
        </Border.GestureRecognizers>
        <Label Text="Rating ↕" FontAttributes="Bold" FontSize="11" LineBreakMode="NoWrap" />
      </Border>
      <Border Grid.Column="3" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
        <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding SortColumnCommand}" CommandParameter="SOS"/>
        </Border.GestureRecognizers>
        <Label Text="SOS ↕" FontAttributes="Bold" FontSize="11" LineBreakMode="NoWrap" />
      </Border>
      <VerticalStackLayout Grid.Column="4" Spacing="0" HorizontalOptions="Center">
        <VerticalStackLayout.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding SortColumnCommand}" CommandParameter="RosterRank"/>
        </VerticalStackLayout.GestureRecognizers>
        <Label Text="Roster" FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
        <Label Text="Rank ↕" FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
      </VerticalStackLayout>

    </Grid>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ROW 2a: Team rankings list with pull-to-refresh     -->
    <!-- IsRefreshing bound OneWay to a dedicated property — -->
    <!-- never IsBusy (see Schedule/Settings fix 2026-09-12) -->
    <!-- ═══════════════════════════════════════════════════ -->
    <RefreshView Grid.Row="2"
                 Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsRefreshing, Mode=OneWay}"
                 IsVisible="False">
      <RefreshView.Triggers>
        <DataTrigger TargetType="RefreshView" Binding="{Binding IsTeamsView}" Value="True">
          <Setter Property="IsVisible" Value="True" />
        </DataTrigger>
      </RefreshView.Triggers>

      <CollectionView ItemsSource="{Binding FilteredTeams}"
                      SelectionMode="None"
                      ItemSizingStrategy="MeasureAllItems">

        <CollectionView.ItemTemplate>
<DataTemplate x:DataType="models:TeamRanking">
    <VerticalStackLayout Spacing="0">

      <!-- ── Main row ── -->
      <Grid Padding="4,3"
            ColumnDefinitions="52,22,*,76,54,50,54">
        <Grid.Triggers>
          <DataTrigger TargetType="Grid" Binding="{Binding IsOddRow}" Value="True">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF8F0, Dark=#2A2A2A}" />
          </DataTrigger>
          <DataTrigger TargetType="Grid" Binding="{Binding IsOddRow}" Value="False">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1A1A1A}" />
          </DataTrigger>
        </Grid.Triggers>

        <!-- Rank badge -->
        <Grid Grid.Column="0"
              Padding="2,2"
              HeightRequest="26"
              WidthRequest="40"
              HorizontalOptions="Center"
              VerticalOptions="Center">
          <BoxView CornerRadius="3"
                   Color="{Binding IsTop25, Converter={StaticResource BoolToColorConverter}}" />
          <Label Text="{Binding OverallRank}"
                 FontSize="11" FontAttributes="Bold" TextColor="White"
                 HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <!-- Heart: follow team -->
        <Border Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFollowCommand}"
                CommandParameter="{Binding .}" />
          </Border.GestureRecognizers>
  <Label
               Text="{Binding IsFollowed, Converter={StaticResource FollowTeamGlyphConverter}}"
               TextColor="{Binding IsFollowed, Converter={StaticResource FollowTeamColorConverter}}"
               FontSize="{StaticResource TeamIconSize}">
          </Label>
</Border>

        <!-- Team + Conf · Tier -->
        <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
          <Label Text="{Binding TeamName}"
                 FontSize="13" LineBreakMode="TailTruncation"
                 TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
            <Label.GestureRecognizers>
              <TapGestureRecognizer
                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.NavigateToTeamCommand}"
                    CommandParameter="{Binding TeamID}" />
            </Label.GestureRecognizers>
          </Label>
          <Label Text="{Binding DisplayConferenceTier}"
                 FontSize="10" TextColor="{AppThemeBinding Light=#99000000, Dark=#99FFFFFF}" LineBreakMode="TailTruncation"/>
        </VerticalStackLayout>

        <Label Grid.Column="3" Text="{Binding RecordWithProjection}"
               FontSize="11" VerticalOptions="Center"/>
        <Label Grid.Column="4" Text="{Binding DisplayRank}"
               FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
        <Label Grid.Column="5" Text="{Binding DisplaySOS}"
               FontSize="11" VerticalOptions="Center"/>
        <Label Grid.Column="6" Text="{Binding DisplayRosterRank}"
               FontSize="11" VerticalOptions="Center" HorizontalOptions="Center"/>

      </Grid>

      <!-- ── Toggle bar: Trend/Pedigree | Season Arc | Offense/Defense | Roster ── -->
      <Grid ColumnDefinitions="1.5*,1.2*,1.4*,0.9*"
            Padding="4,2,8,2">
        <Grid.Triggers>
          <DataTrigger TargetType="Grid" Binding="{Binding IsOddRow}" Value="True">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF8F0, Dark=#2A2A2A}" />
          </DataTrigger>
          <DataTrigger TargetType="Grid" Binding="{Binding IsOddRow}" Value="False">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1A1A1A}" />
          </DataTrigger>
        </Grid.Triggers>

        <!-- LEFT: Trend / Pedigree — disabled/grayed without Season Pass,
             not tappable, no popup (design locked 2026-07-24). -->
        <Border Grid.Column="0" HorizontalOptions="Start" IsVisible="{Binding HasTrendData}" IsEnabled="{Binding Source={x:Reference ThisPage}, Path=BindingContext.HasSeasonPass}" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleTrendExpandCommand}"
                CommandParameter="{Binding .}" />
          </Border.GestureRecognizers>
  <Label
               FontSize="11"
               LineBreakMode="NoWrap"
               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
          <Label.FormattedText>
            <FormattedString>
              <Span Text="Trend / Pedigree" />
              <Span Text="  " />
              <Span Text="{Binding TrendExpandIcon}" FontSize="8" />
            </FormattedString>
          </Label.FormattedText>
          <Label.Triggers>
            <DataTrigger TargetType="Label"
                         Binding="{Binding Source={x:Reference ThisPage}, Path=BindingContext.HasSeasonPass}"
                         Value="False">
              <Setter Property="TextColor" Value="{AppThemeBinding Light=#596B4EAE, Dark=#599B7EDE}" />
            </DataTrigger>
          </Label.Triggers>
          </Label>
</Border>

        <!-- Season Arc — disabled/grayed without Season Pass -->
        <Border Grid.Column="1" HorizontalOptions="Center" IsEnabled="{Binding Source={x:Reference ThisPage}, Path=BindingContext.HasSeasonPass}" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleArcExpandCommand}"
                CommandParameter="{Binding .}" />
          </Border.GestureRecognizers>
  <Label
               FontSize="11"
               LineBreakMode="NoWrap"
               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
          <Label.FormattedText>
            <FormattedString>
              <Span Text="Season Arc" />
              <Span Text="  " />
              <Span Text="{Binding ArcExpandIcon}" FontSize="8" />
            </FormattedString>
          </Label.FormattedText>
          <Label.Triggers>
            <DataTrigger TargetType="Label"
                         Binding="{Binding Source={x:Reference ThisPage}, Path=BindingContext.HasSeasonPass}"
                         Value="False">
              <Setter Property="TextColor" Value="{AppThemeBinding Light=#596B4EAE, Dark=#599B7EDE}" />
            </DataTrigger>
          </Label.Triggers>
          </Label>
</Border>

        <!-- Offense / Defense — disabled/grayed without Season Pass. Moved from
             HorizontalOptions="End" to "Center": no longer the rightmost column
             now that Roster sits to its right. -->
        <Border Grid.Column="2" HorizontalOptions="Center" IsVisible="{Binding HasOffenseDefenseData}" IsEnabled="{Binding Source={x:Reference ThisPage}, Path=BindingContext.HasSeasonPass}" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleStatsExpandCommand}"
                CommandParameter="{Binding .}" />
          </Border.GestureRecognizers>
  <Label
               FontSize="11"
               LineBreakMode="NoWrap"
               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
          <Label.FormattedText>
            <FormattedString>
              <Span Text="Offense / Defense" />
              <Span Text="  " />
              <Span Text="{Binding StatsExpandIcon}" FontSize="8" />
            </FormattedString>
          </Label.FormattedText>
          <Label.Triggers>
            <DataTrigger TargetType="Label"
                         Binding="{Binding Source={x:Reference ThisPage}, Path=BindingContext.HasSeasonPass}"
                         Value="False">
              <Setter Property="TextColor" Value="{AppThemeBinding Light=#596B4EAE, Dark=#599B7EDE}" />
            </DataTrigger>
          </Label.Triggers>
          </Label>
</Border>

        <!-- RIGHT: Roster — new. Gated behind Season Pass like Trend/Pedigree and
             Season Arc (confirmed 2026-08). No IsVisible data-presence gate yet
             (unlike Offense/Defense's HasOffenseDefenseData) — roster availability
             isn't known until the lazy fetch runs, matching Season Arc's always-
             visible approach rather than Offense/Defense's pre-known-data approach.
             The panel itself shows an empty state if RosterCapacityService returns
             no ZRoster for the team/year, per the API's documented null-coverage
             caveat. -->
        <Border Grid.Column="3" HorizontalOptions="End" IsEnabled="{Binding Source={x:Reference ThisPage}, Path=BindingContext.HasSeasonPass}" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleRosterExpandCommand}"
                CommandParameter="{Binding .}" />
          </Border.GestureRecognizers>
  <Label
               FontSize="11"
               LineBreakMode="NoWrap"
               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
          <Label.FormattedText>
            <FormattedString>
              <Span Text="Roster" />
              <Span Text="  " />
              <Span Text="{Binding RosterExpandIcon}" FontSize="8" />
            </FormattedString>
          </Label.FormattedText>
          <Label.Triggers>
            <DataTrigger TargetType="Label"
                         Binding="{Binding Source={x:Reference ThisPage}, Path=BindingContext.HasSeasonPass}"
                         Value="False">
              <Setter Property="TextColor" Value="{AppThemeBinding Light=#596B4EAE, Dark=#599B7EDE}" />
            </DataTrigger>
          </Label.Triggers>
          </Label>
</Border>

      </Grid>

      <!-- ── Trend / Pedigree expanded panel (lazy) ── -->
      <controls:LazyContentView IsExpanded="{Binding IsTrendExpanded}">
        <controls:LazyContentView.LazyTemplate>
          <DataTemplate>
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#D8D8D8, Dark=#3A3A3A}"
                    BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#202020}"
                    Margin="4,0,4,6">
              <VerticalStackLayout Spacing="0">

                <Grid ColumnDefinitions="*,Auto,Auto" Padding="12,8,12,2">
                  <Label Grid.Column="0"
                         Text="Trend / Pedigree History"
                         FontSize="10" FontAttributes="Bold"
                         TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
                  <Label Grid.Column="1"
                         Text="{Binding Record}"
                         FontSize="9" TextColor="{AppThemeBinding Light=#99000000, Dark=#99FFFFFF}"
                         Margin="0,0,10,0" />
                  <VerticalStackLayout Grid.Column="2" Spacing="0">
                    <Label Text="{Binding TrendRating, StringFormat='Trend {0:F4}'}"
                           FontSize="9" FontAttributes="Bold"
                           HorizontalTextAlignment="End"
                           TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
                    <Label Text="{Binding PedigreeRating, StringFormat='Pedigree {0:F4}'}"
                           FontSize="9" FontAttributes="Bold"
                           HorizontalTextAlignment="End"
                           TextColor="{AppThemeBinding Light=#3D7AB5, Dark=#5FA8E8}" />
                  </VerticalStackLayout>
                </Grid>

                <chart:SfCartesianChart HeightRequest="160" Margin="8,0,8,8">
                  <chart:SfCartesianChart.XAxes>
                    <chart:CategoryAxis ShowMajorGridLines="False"
                                        LabelPlacement="BetweenTicks" />
                  </chart:SfCartesianChart.XAxes>
                  <chart:SfCartesianChart.YAxes>
                    <chart:NumericalAxis Minimum="0" Maximum="1.2"
                                         Interval="0.2"
                                         ShowMajorGridLines="True" />
                  </chart:SfCartesianChart.YAxes>
                  <chart:SplineSeries
                      ItemsSource="{Binding TrendPoints}"
                      XBindingPath="Index" YBindingPath="Value"
                      Label="Trend"
                      Fill="{AppThemeBinding Light={StaticResource AccentChartLight}, Dark={StaticResource AccentChartDark}}"
                      StrokeWidth="3.5" EnableTooltip="True" />
                  <chart:SplineSeries
                      ItemsSource="{Binding PedigreePoints}"
                      XBindingPath="Index" YBindingPath="Value"
                      Label="Pedigree"
                      Fill="{AppThemeBinding Light=#C89B3C, Dark=#FFD166}"
                      StrokeWidth="2.5" EnableTooltip="True" />
                  <chart:SfCartesianChart.Legend>
                    <chart:ChartLegend Placement="Bottom" />
                  </chart:SfCartesianChart.Legend>
                </chart:SfCartesianChart>

              </VerticalStackLayout>
            </Border>
          </DataTemplate>
        </controls:LazyContentView.LazyTemplate>
      </controls:LazyContentView>

      <!-- ── Season Arc expanded panel (lazy) ── -->
      <controls:LazyContentView IsExpanded="{Binding IsArcExpanded}">
        <controls:LazyContentView.LazyTemplate>
          <DataTemplate>
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#C8E6C9, Dark=#2E4A35}"
                    BackgroundColor="{AppThemeBinding Light=#F1F8F2, Dark=#1A2A1E}"
                    Margin="4,0,4,6">
              <VerticalStackLayout Spacing="0">

                <Grid ColumnDefinitions="*,Auto" Padding="12,8,12,2">
                  <Label Grid.Column="0"
                         Text="Season Arc"
                         FontSize="10" FontAttributes="Bold"
                         TextColor="{AppThemeBinding Light=#2E8B57, Dark=#4CAF84}" />
                  <Label Grid.Column="1"
                         Text="{Binding Record}"
                         FontSize="9" TextColor="{AppThemeBinding Light=#99000000, Dark=#99FFFFFF}" />
                </Grid>

                <chart:SfCartesianChart HeightRequest="170" Margin="8,0,8,8">
                  <chart:SfCartesianChart.XAxes>
                    <chart:NumericalAxis ShowMajorGridLines="False"
                                         Minimum="1" Interval="2">
                      <chart:NumericalAxis.Title>
                        <chart:ChartAxisTitle Text="Week" FontSize="9" />
                      </chart:NumericalAxis.Title>
                    </chart:NumericalAxis>
                  </chart:SfCartesianChart.XAxes>
                  <chart:SfCartesianChart.YAxes>
                    <!-- Single shared axis — Rating/SOS/WinPct all fall in -1 to 2 range -->
                    <chart:NumericalAxis
                       Minimum="-1" Maximum="2" Interval="0.5"
                       ShowMajorGridLines="True" />
                  </chart:SfCartesianChart.YAxes>
                  <chart:SplineSeries
                      ItemsSource="{Binding ArcRankingPoints}"
                      XBindingPath="Index" YBindingPath="Value"
                      Label="Rating"
                      Fill="{AppThemeBinding Light={StaticResource AccentChartLight}, Dark={StaticResource AccentChartDark}}"
                      StrokeWidth="3" EnableTooltip="True" />
                  <chart:SplineSeries
                      ItemsSource="{Binding ArcSosPoints}"
                      XBindingPath="Index" YBindingPath="Value"
                      Label="SOS"
                      Fill="{AppThemeBinding Light=#FF4444, Dark=#FF6B6B}"
                      StrokeWidth="2.5" EnableTooltip="True" />
                  <chart:SplineSeries
                      ItemsSource="{Binding ArcWinPctPoints}"
                      XBindingPath="Index" YBindingPath="Value"
                      Label="Win %"
                      Fill="{AppThemeBinding Light=#FFE500, Dark=#FFE500}"
                      StrokeWidth="2" EnableTooltip="True" />
                  <chart:SfCartesianChart.Legend>
                    <chart:ChartLegend Placement="Bottom" />
                  </chart:SfCartesianChart.Legend>
                </chart:SfCartesianChart>

              </VerticalStackLayout>
            </Border>
          </DataTemplate>
        </controls:LazyContentView.LazyTemplate>
      </controls:LazyContentView>

      <!-- ── Offense / Defense expanded panel ── -->
      <!-- Labels only — no charts — IsVisible is fine here -->
      <VerticalStackLayout IsVisible="{Binding IsStatsExpanded}"
                           Spacing="0"
                           BackgroundColor="{AppThemeBinding Light={StaticResource PanelBackgroundLight}, Dark={StaticResource PanelBackgroundDark}}">

        <Grid ColumnDefinitions="*,*,*" Padding="8,6,8,4" ColumnSpacing="4">
          <VerticalStackLayout Grid.Column="0" Spacing="1">
            <Label Text="Offensive Rank" FontSize="9" TextColor="{AppThemeBinding Light=#99000000, Dark=#99FFFFFF}" />
            <Label Text="{Binding OffensiveRankDisplay}"
                   FontSize="10" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
          </VerticalStackLayout>
          <VerticalStackLayout Grid.Column="1" Spacing="1">
            <Label Text="Avg. Points Scored" FontSize="9" TextColor="{AppThemeBinding Light=#99000000, Dark=#99FFFFFF}" />
            <Label Text="{Binding AvgPointsScored, StringFormat='{0:F1}'}"
                   FontSize="10" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
          </VerticalStackLayout>
          <VerticalStackLayout Grid.Column="2" Spacing="1">
            <Label Text="Offensive Index (Std-Z)" FontSize="9" TextColor="{AppThemeBinding Light=#99000000, Dark=#99FFFFFF}" />
            <Label Text="{Binding OffensiveZScore, StringFormat='{0:F4}'}"
                   FontSize="10" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
          </VerticalStackLayout>
        </Grid>

        <BoxView HeightRequest="1"  Margin="8,0"
                 Color="{AppThemeBinding Light=#14000000, Dark=#14FFFFFF}" />

        <Grid ColumnDefinitions="*,*,*" Padding="8,4,8,6" ColumnSpacing="4">
          <VerticalStackLayout Grid.Column="0" Spacing="1">
            <Label Text="Defensive Rank" FontSize="9" TextColor="{AppThemeBinding Light=#99000000, Dark=#99FFFFFF}" />
            <Label Text="{Binding DefensiveRankDisplay}"
                   FontSize="10" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
          </VerticalStackLayout>
          <VerticalStackLayout Grid.Column="1" Spacing="1">
            <Label Text="Avg. Points Allowed" FontSize="9" TextColor="{AppThemeBinding Light=#99000000, Dark=#99FFFFFF}" />
            <Label Text="{Binding AvgPointsAllowed, StringFormat='{0:F1}'}"
                   FontSize="10" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
          </VerticalStackLayout>
          <VerticalStackLayout Grid.Column="2" Spacing="1">
            <Label Text="Defensive Index (Std-Z)" FontSize="9" TextColor="{AppThemeBinding Light=#99000000, Dark=#99FFFFFF}" />
            <Label Text="{Binding DefensiveZScore, StringFormat='{0:F4}'}"
                   FontSize="10" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
          </VerticalStackLayout>
        </Grid>

      </VerticalStackLayout>

      <!-- ── Roster Changes expanded panel — summary table + one shared
           expandable list area (Recruiting / Portal In / Portal Out).
           Retained/Departed/New are still in the API response but not
           rendered here — reserved for the future standalone Roster page
           per 2026-08 UX decision. ── -->
      <VerticalStackLayout IsVisible="{Binding IsRosterExpanded}"
                           Spacing="0"
                           BackgroundColor="{AppThemeBinding Light={StaticResource PanelBackgroundLight}, Dark={StaticResource PanelBackgroundDark}}">

        <Label Text="No roster data available for this year."
               IsVisible="{Binding ShowRosterEmptyState}"
               FontSize="10" TextColor="{AppThemeBinding Light=#99000000, Dark=#99FFFFFF}" Padding="8,6" />

        <VerticalStackLayout IsVisible="{Binding HasRosterData}" Spacing="0">

          <!-- ── Summary table: Prior | Current | Change, one row per metric.
               Positive/negative Change values use a 3-section custom numeric
               format string ("+0.0;-0.0;0.0") — standard .NET formatting,
               not a converter — to get an explicit "+" on gains. ── -->
          <Grid ColumnDefinitions="*,50,50,55" Padding="8,6,8,2" RowSpacing="3">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Column headers -->
            <Label Grid.Row="0" Grid.Column="1" Text="Prior" FontSize="8" TextColor="{AppThemeBinding Light=#80000000, Dark=#80FFFFFF}" HorizontalOptions="End" />
            <Label Grid.Row="0" Grid.Column="2" Text="Now" FontSize="8" TextColor="{AppThemeBinding Light=#80000000, Dark=#80FFFFFF}" HorizontalOptions="End" />
            <Label Grid.Row="0" Grid.Column="3" Text="Change" FontSize="8" TextColor="{AppThemeBinding Light=#80000000, Dark=#80FFFFFF}" HorizontalOptions="End" />

            <!-- Roster Rank -->
            <Label Grid.Row="1" Grid.Column="0" Text="Roster Rank" FontSize="10" VerticalOptions="Center" />
            <Label Grid.Row="1" Grid.Column="1" FontSize="10" HorizontalOptions="End" TextColor="{AppThemeBinding Light=#B3000000, Dark=#B3FFFFFF}"
                   Text="{Binding RosterChanges.RosterStrength.PriorRank, StringFormat='#{0}'}" />
            <Label Grid.Row="1" Grid.Column="2" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                   Text="{Binding RosterChanges.RosterStrength.CurrentRank, StringFormat='#{0}'}" />
            <Label Grid.Row="1" Grid.Column="3" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   Text="{Binding RosterChanges.RosterStrength.RankChange, StringFormat='{0:+0;-0;0}'}" />

            <!-- Roster Rating (10 × Φ(ZRoster)) -->
            <Label Grid.Row="2" Grid.Column="0" Text="Roster Rating" FontSize="10" VerticalOptions="Center" />
            <Label Grid.Row="2" Grid.Column="1" FontSize="10" HorizontalOptions="End" TextColor="{AppThemeBinding Light=#B3000000, Dark=#B3FFFFFF}"
                   Text="{Binding RosterChanges.RosterStrength.PriorRatingDisplay, StringFormat='{0:F1}'}" />
            <Label Grid.Row="2" Grid.Column="2" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                   Text="{Binding RosterChanges.RosterStrength.CurrentRatingDisplay, StringFormat='{0:F1}'}" />
            <Label Grid.Row="2" Grid.Column="3" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   Text="{Binding RosterChanges.RosterStrength.RatingChange, StringFormat='{0:+0.0;-0.0;0.0}'}" />

            <!-- Recruiting — tappable, opens the shared list below -->
            <Border Grid.Column="0" Grid.Row="3" VerticalOptions="Center" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
                <TapGestureRecognizer
                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleRecruitingListCommand}"
                    CommandParameter="{Binding .}" />
              </Border.GestureRecognizers>
  <Label FontSize="11"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
              <Label.FormattedText>
                <FormattedString>
                  <Span Text="Recruiting  " />
                  <Span Text="{Binding RecruitingListIcon}" FontSize="8" />
                </FormattedString>
              </Label.FormattedText>
              </Label>
</Border>
            <Label Grid.Row="3" Grid.Column="1" FontSize="10" HorizontalOptions="End" TextColor="{AppThemeBinding Light=#B3000000, Dark=#B3FFFFFF}"
                   Text="{Binding RosterChanges.RecruitingComposite.Prior, StringFormat='{0:F1}'}" />
            <Label Grid.Row="3" Grid.Column="2" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                   Text="{Binding RosterChanges.RecruitingComposite.Current, StringFormat='{0:F1}'}" />
            <Label Grid.Row="3" Grid.Column="3" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   Text="{Binding RosterChanges.RecruitingComposite.Change, StringFormat='{0:+0.0;-0.0;0.0}'}" />

            <!-- Portal In — tappable -->
            <Border Grid.Column="0" Grid.Row="4" VerticalOptions="Center" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
                <TapGestureRecognizer
                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.TogglePortalInListCommand}"
                    CommandParameter="{Binding .}" />
              </Border.GestureRecognizers>
  <Label FontSize="11"
                   TextColor="{AppThemeBinding Light={StaticResource ResultWinLight}, Dark={StaticResource ResultWinDark}}">
              <Label.FormattedText>
                <FormattedString>
                  <Span Text="Portal In  " />
                  <Span Text="{Binding PortalInListIcon}" FontSize="8" />
                </FormattedString>
              </Label.FormattedText>
              </Label>
</Border>
            <Label Grid.Row="4" Grid.Column="1" FontSize="10" HorizontalOptions="End" TextColor="{AppThemeBinding Light=#B3000000, Dark=#B3FFFFFF}"
                   Text="{Binding RosterChanges.PortalInComposite.Prior, StringFormat='{0:F1}'}" />
            <Label Grid.Row="4" Grid.Column="2" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   TextColor="{AppThemeBinding Light={StaticResource ResultWinLight}, Dark={StaticResource ResultWinDark}}"
                   Text="{Binding RosterChanges.PortalInComposite.Current, StringFormat='{0:F1}'}" />
            <Label Grid.Row="4" Grid.Column="3" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   Text="{Binding RosterChanges.PortalInComposite.Change, StringFormat='{0:+0.0;-0.0;0.0}'}" />

            <!-- Portal Out — tappable. Values are pre-negated at the API. -->
            <Border Grid.Column="0" Grid.Row="5" VerticalOptions="Center" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
                <TapGestureRecognizer
                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.TogglePortalOutListCommand}"
                    CommandParameter="{Binding .}" />
              </Border.GestureRecognizers>
  <Label FontSize="11"
                   TextColor="{AppThemeBinding Light={StaticResource ResultLossLight}, Dark={StaticResource ResultLossDark}}">
              <Label.FormattedText>
                <FormattedString>
                  <Span Text="Portal Out  " />
                  <Span Text="{Binding PortalOutListIcon}" FontSize="8" />
                </FormattedString>
              </Label.FormattedText>
              </Label>
</Border>
            <Label Grid.Row="5" Grid.Column="1" FontSize="10" HorizontalOptions="End" TextColor="{AppThemeBinding Light=#B3000000, Dark=#B3FFFFFF}"
                   Text="{Binding RosterChanges.PortalOutComposite.Prior, StringFormat='{0:F1}'}" />
            <Label Grid.Row="5" Grid.Column="2" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   TextColor="{AppThemeBinding Light={StaticResource ResultLossLight}, Dark={StaticResource ResultLossDark}}"
                   Text="{Binding RosterChanges.PortalOutComposite.Current, StringFormat='{0:F1}'}" />
            <Label Grid.Row="5" Grid.Column="3" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   Text="{Binding RosterChanges.PortalOutComposite.Change, StringFormat='{0:+0.0;-0.0;0.0}'}" />

          </Grid>

          <!-- Portal Composite — not tappable (derived, no list of its own).
               Separate row below the main grid so its own emphasis doesn't
               compete with the tappable rows above. -->
          <Grid ColumnDefinitions="*,50,50,55" Padding="8,2,8,6">
            <Label Grid.Column="0" Text="Portal Net" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
            <Label Grid.Column="1" FontSize="10" HorizontalOptions="End" TextColor="{AppThemeBinding Light=#B3000000, Dark=#B3FFFFFF}"
                   Text="{Binding RosterChanges.PortalNetComposite.Prior, StringFormat='{0:F1}'}" />
            <Label Grid.Column="2" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                   Text="{Binding RosterChanges.PortalNetComposite.Current, StringFormat='{0:F1}'}" />
            <Label Grid.Column="3" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   Text="{Binding RosterChanges.PortalNetComposite.Change, StringFormat='{0:+0.0;-0.0;0.0}'}" />
          </Grid>

          <BoxView HeightRequest="1"  Margin="8,0"
                   Color="{AppThemeBinding Light=#14000000, Dark=#14FFFFFF}" />

          <!-- ── Shared list area — one of the three below is ever visible at
               once, driven by ActiveRosterListKey. Physically all three sit
               in the same position; only the active one has height. ── -->

          <VerticalStackLayout IsVisible="{Binding IsRecruitingListActive}"
                               Padding="8,4,8,6" Spacing="2">

            <!-- Header — no label over the star-rank column -->
            <Grid ColumnDefinitions="20,2*,*,50" Padding="0,0,0,2">
              <Label Grid.Column="1" Text="Player" FontSize="8" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#80000000, Dark=#80FFFFFF}" />
              <Label Grid.Column="2" Text="Comment" FontSize="8" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#80000000, Dark=#80FFFFFF}" />
              <Label Grid.Column="3" Text="Rating" FontSize="8" FontAttributes="Bold"
                     HorizontalOptions="End" TextColor="{AppThemeBinding Light=#80000000, Dark=#80FFFFFF}" />
            </Grid>
            <BoxView HeightRequest="1" Margin="0,0,0,2"
                     Color="{AppThemeBinding Light=#1A000000, Dark=#1AFFFFFF}" />

            <VerticalStackLayout Spacing="2"
                                 BindableLayout.ItemsSource="{Binding RosterChanges.RecruitingClass}">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:RecruitSummary">
                  <Grid ColumnDefinitions="20,2*,*,50" Padding="0,1">
                    <Label Grid.Column="0" Text="{Binding Stars, StringFormat='{0}★'}" FontSize="9" />
                    <Label Grid.Column="1" FontSize="9">
                      <Label.FormattedText>
                        <FormattedString>
                          <Span Text="{Binding Name}" />
                          <Span Text=" · " TextColor="{AppThemeBinding Light=#80000000, Dark=#80FFFFFF}" />
                          <Span Text="{Binding Position}" TextColor="{AppThemeBinding Light=#B3000000, Dark=#B3FFFFFF}" />
                        </FormattedString>
                      </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="2" Text="" FontSize="9" />
                    <Label Grid.Column="3" Text="{Binding Rating, StringFormat='{0:F3}'}"
                           FontSize="9" HorizontalOptions="End" TextColor="{AppThemeBinding Light=#B3000000, Dark=#B3FFFFFF}" />
                  </Grid>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

          </VerticalStackLayout>

          <VerticalStackLayout IsVisible="{Binding IsPortalInListActive}"
                               Padding="8,4,8,6" Spacing="2">

            <Grid ColumnDefinitions="2*,*,50" Padding="0,0,0,2">
              <Label Grid.Column="0" Text="Player" FontSize="8" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#80000000, Dark=#80FFFFFF}" />
              <Label Grid.Column="1" Text="Comment" FontSize="8" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#80000000, Dark=#80FFFFFF}" />
              <Label Grid.Column="2" Text="Rating" FontSize="8" FontAttributes="Bold"
                     HorizontalOptions="End" TextColor="{AppThemeBinding Light=#80000000, Dark=#80FFFFFF}" />
            </Grid>
            <BoxView HeightRequest="1" Margin="0,0,0,2"
                     Color="{AppThemeBinding Light=#1A000000, Dark=#1AFFFFFF}" />

            <VerticalStackLayout Spacing="2"
                                 BindableLayout.ItemsSource="{Binding RosterChanges.PortalIn}">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:PortalTransfer">
                  <Grid ColumnDefinitions="2*,*,50" Padding="0,1">
                    <Label Grid.Column="0" FontSize="9">
                      <Label.FormattedText>
                        <FormattedString>
                          <Span Text="{Binding Name}" />
                          <Span Text=" · " TextColor="{AppThemeBinding Light=#80000000, Dark=#80FFFFFF}" />
                          <Span Text="{Binding Position}" TextColor="{AppThemeBinding Light=#B3000000, Dark=#B3FFFFFF}" />
                        </FormattedString>
                      </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="1" Text="{Binding OtherTeam, StringFormat='from {0}'}"
                           FontSize="9" TextColor="{AppThemeBinding Light=#99000000, Dark=#99FFFFFF}" LineBreakMode="TailTruncation" />
                    <Label Grid.Column="2" Text="{Binding Rating, StringFormat='{0:F3}'}"
                           FontSize="9" HorizontalOptions="End" TextColor="{AppThemeBinding Light=#B3000000, Dark=#B3FFFFFF}" />
                  </Grid>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

          </VerticalStackLayout>

          <VerticalStackLayout IsVisible="{Binding IsPortalOutListActive}"
                               Padding="8,4,8,6" Spacing="2">

            <Grid ColumnDefinitions="2*,*,50" Padding="0,0,0,2">
              <Label Grid.Column="0" Text="Player" FontSize="8" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#80000000, Dark=#80FFFFFF}" />
              <Label Grid.Column="1" Text="Comment" FontSize="8" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#80000000, Dark=#80FFFFFF}" />
              <Label Grid.Column="2" Text="Rating" FontSize="8" FontAttributes="Bold"
                     HorizontalOptions="End" TextColor="{AppThemeBinding Light=#80000000, Dark=#80FFFFFF}" />
            </Grid>
            <BoxView HeightRequest="1" Margin="0,0,0,2"
                     Color="{AppThemeBinding Light=#1A000000, Dark=#1AFFFFFF}" />

            <VerticalStackLayout Spacing="2"
                                 BindableLayout.ItemsSource="{Binding RosterChanges.PortalOut}">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:PortalTransfer">
                  <Grid ColumnDefinitions="2*,*,50" Padding="0,1">
                    <Label Grid.Column="0" FontSize="9">
                      <Label.FormattedText>
                        <FormattedString>
                          <Span Text="{Binding Name}" />
                          <Span Text=" · " TextColor="{AppThemeBinding Light=#80000000, Dark=#80FFFFFF}" />
                          <Span Text="{Binding Position}" TextColor="{AppThemeBinding Light=#B3000000, Dark=#B3FFFFFF}" />
                        </FormattedString>
                      </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="1" Text="{Binding OtherTeam, StringFormat='to {0}'}"
                           FontSize="9" TextColor="{AppThemeBinding Light=#99000000, Dark=#99FFFFFF}" LineBreakMode="TailTruncation" />
                    <Label Grid.Column="2" Text="{Binding Rating, StringFormat='{0:F3}'}"
                           FontSize="9" HorizontalOptions="End" TextColor="{AppThemeBinding Light=#B3000000, Dark=#B3FFFFFF}" />
                  </Grid>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

          </VerticalStackLayout>

        </VerticalStackLayout>
      </VerticalStackLayout>

      <BoxView HeightRequest="1" 
               Color="{AppThemeBinding Light=#1A000000, Dark=#1AFFFFFF}" />

    </VerticalStackLayout>
  </DataTemplate>
</CollectionView.ItemTemplate>

        <CollectionView.EmptyView>
          <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
            <Label Text="{Binding EmptyMessage}" FontSize="14" TextColor="{AppThemeBinding Light=#B3000000, Dark=#B3FFFFFF}"
                   HorizontalOptions="Center" Margin="0,10,0,0"/>
          </VerticalStackLayout>
        </CollectionView.EmptyView>

      </CollectionView>

    </RefreshView>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ROW 2c: Top 25 — two columns, 1–12 left, 13–25 right -->
    <!-- National by OverallRank; ignores filters/favorites  -->
    <!-- ═══════════════════════════════════════════════════ -->
    <RefreshView Grid.Row="2"
                 Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsRefreshing, Mode=OneWay}"
                 IsVisible="False">
      <RefreshView.Triggers>
        <DataTrigger TargetType="RefreshView" Binding="{Binding IsTop25View}" Value="True">
          <Setter Property="IsVisible" Value="True" />
        </DataTrigger>
      </RefreshView.Triggers>

      <ScrollView>
        <VerticalStackLayout Spacing="0">

          <Label Text="{Binding EmptyMessage}"
                 IsVisible="{Binding HasNoTop25}"
                 FontSize="14" HorizontalOptions="Center" Margin="0,30,0,0"
                 TextColor="{AppThemeBinding Light=#B3000000, Dark=#B3FFFFFF}" />

          <Grid ColumnDefinitions="*,*" ColumnSpacing="4" Padding="4,4"
                IsVisible="{Binding HasTop25}">

            <!-- Left: 1–12 -->
            <VerticalStackLayout Grid.Column="0" Spacing="0"
                                 BindableLayout.ItemsSource="{Binding Top25Left}">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:Top25Card">
                <Grid Padding="4,5" ColumnDefinitions="22,*" RowDefinitions="Auto,Auto" ColumnSpacing="4">
                  <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsOddRow}" Value="True">
                      <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF8F0, Dark=#2A2A2A}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsOddRow}" Value="False">
                      <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1A1A1A}" />
                    </DataTrigger>
                  </Grid.Triggers>

                  <!-- Small rank badge -->
                  <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                        HeightRequest="20" WidthRequest="22"
                        HorizontalOptions="Start" VerticalOptions="Center">
                    <BoxView CornerRadius="3"
                             Color="{Binding IsTop25, Converter={StaticResource BoolToColorConverter}}" />
                    <Label Text="{Binding Rank}"
                           FontSize="9" FontAttributes="Bold" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                  </Grid>

                  <!-- Team (only tap target — gesture on the team Span) + (CONF) -->
                  <Label Grid.Row="0" Grid.Column="1"
                         FontSize="12" LineBreakMode="TailTruncation">
                    <Label.FormattedText>
                      <FormattedString>
                        <Span Text="{Binding TeamName}"
                              TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                          <Span.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.NavigateToTeamCommand}"
                                CommandParameter="{Binding TeamID}" />
                          </Span.GestureRecognizers>
                        </Span>
                        <Span Text="{Binding DisplayConferenceSuffix}"
                              FontSize="10"
                              TextColor="{AppThemeBinding Light=#99000000, Dark=#99FFFFFF}" />
                      </FormattedString>
                    </Label.FormattedText>
                  </Label>

                  <!-- Actual record · Rating -->
                  <Label Grid.Row="1" Grid.Column="1"
                         FontSize="10" LineBreakMode="TailTruncation"
                         TextColor="{AppThemeBinding Light=#99000000, Dark=#99FFFFFF}">
                    <Label.FormattedText>
                      <FormattedString>
                        <Span Text="{Binding Record}" />
                        <Span Text="  ·  " />
                        <Span Text="{Binding DisplayRating}" FontAttributes="Bold" />
                      </FormattedString>
                    </Label.FormattedText>
                  </Label>
                </Grid>
              </DataTemplate>
              </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Right: 13–25 -->
            <VerticalStackLayout Grid.Column="1" Spacing="0"
                                 BindableLayout.ItemsSource="{Binding Top25Right}">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:Top25Card">
                <Grid Padding="4,5" ColumnDefinitions="22,*" RowDefinitions="Auto,Auto" ColumnSpacing="4">
                  <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsOddRow}" Value="True">
                      <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF8F0, Dark=#2A2A2A}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsOddRow}" Value="False">
                      <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1A1A1A}" />
                    </DataTrigger>
                  </Grid.Triggers>

                  <!-- Small rank badge -->
                  <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                        HeightRequest="20" WidthRequest="22"
                        HorizontalOptions="Start" VerticalOptions="Center">
                    <BoxView CornerRadius="3"
                             Color="{Binding IsTop25, Converter={StaticResource BoolToColorConverter}}" />
                    <Label Text="{Binding Rank}"
                           FontSize="9" FontAttributes="Bold" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                  </Grid>

                  <!-- Team (only tap target — gesture on the team Span) + (CONF) -->
                  <Label Grid.Row="0" Grid.Column="1"
                         FontSize="12" LineBreakMode="TailTruncation">
                    <Label.FormattedText>
                      <FormattedString>
                        <Span Text="{Binding TeamName}"
                              TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                          <Span.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.NavigateToTeamCommand}"
                                CommandParameter="{Binding TeamID}" />
                          </Span.GestureRecognizers>
                        </Span>
                        <Span Text="{Binding DisplayConferenceSuffix}"
                              FontSize="10"
                              TextColor="{AppThemeBinding Light=#99000000, Dark=#99FFFFFF}" />
                      </FormattedString>
                    </Label.FormattedText>
                  </Label>

                  <!-- Actual record · Rating -->
                  <Label Grid.Row="1" Grid.Column="1"
                         FontSize="10" LineBreakMode="TailTruncation"
                         TextColor="{AppThemeBinding Light=#99000000, Dark=#99FFFFFF}">
                    <Label.FormattedText>
                      <FormattedString>
                        <Span Text="{Binding Record}" />
                        <Span Text="  ·  " />
                        <Span Text="{Binding DisplayRating}" FontAttributes="Bold" />
                      </FormattedString>
                    </Label.FormattedText>
                  </Label>
                </Grid>
              </DataTemplate>
              </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

          </Grid>

        </VerticalStackLayout>
      </ScrollView>

    </RefreshView>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ROW 2b: Conference averages list                    -->
    <!-- ═══════════════════════════════════════════════════ -->
    <RefreshView Grid.Row="2"
                 Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsRefreshing, Mode=OneWay}"
                 IsVisible="False">
      <RefreshView.Triggers>
        <DataTrigger TargetType="RefreshView" Binding="{Binding IsConferencesView}" Value="True">
          <Setter Property="IsVisible" Value="True" />
        </DataTrigger>
      </RefreshView.Triggers>

      <CollectionView ItemsSource="{Binding ConferenceSummaries}"
                      SelectionMode="None">

        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="models:ConferenceSummary">
            <VerticalStackLayout Spacing="0">

              <Grid Padding="4,5"
                    ColumnDefinitions="52,*,54,50,54">
                <Grid.Triggers>
                  <DataTrigger TargetType="Grid" Binding="{Binding IsOddRow}" Value="True">
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF8F0, Dark=#2A2A2A}" />
                  </DataTrigger>
                  <DataTrigger TargetType="Grid" Binding="{Binding IsOddRow}" Value="False">
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1A1A1A}" />
                  </DataTrigger>
                </Grid.Triggers>

                <!-- Rank badge (by avg Rating) -->
                <Grid Grid.Column="0"
                      Padding="2,2"
                      HeightRequest="26"
                      WidthRequest="40"
                      HorizontalOptions="Center"
                      VerticalOptions="Center">
                  <BoxView CornerRadius="3"
                           Color="{Binding IsTop25, Converter={StaticResource BoolToColorConverter}}" />
                  <Label Text="{Binding ConferenceRank}"
                         FontSize="11" FontAttributes="Bold" TextColor="White"
                         HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>

                <!-- Conference name (tap → Teams filtered to this conference) + subtitle -->
                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                  <Label Text="{Binding ConferenceName}"
                         FontSize="13" LineBreakMode="TailTruncation"
                         TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                    <Label.GestureRecognizers>
                      <TapGestureRecognizer
                          Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.NavigateToConferenceCommand}"
                          CommandParameter="{Binding ConferenceKey}" />
                    </Label.GestureRecognizers>
                  </Label>
                  <Label Text="{Binding DisplaySubtitle}"
                         FontSize="10" TextColor="{AppThemeBinding Light=#99000000, Dark=#99FFFFFF}" LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>

                <Label Grid.Column="2" Text="{Binding DisplayRating}"
                       FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                <Label Grid.Column="3" Text="{Binding DisplaySOS}"
                       FontSize="11" VerticalOptions="Center"/>
                <Label Grid.Column="4" Text="{Binding DisplayRosterRank}"
                       FontSize="11" VerticalOptions="Center" HorizontalOptions="Center"/>

              </Grid>

              <BoxView HeightRequest="1"
                       Color="{AppThemeBinding Light=#1A000000, Dark=#1AFFFFFF}" />

            </VerticalStackLayout>
          </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.EmptyView>
          <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
            <Label Text="{Binding EmptyMessage}" FontSize="14" TextColor="{AppThemeBinding Light=#B3000000, Dark=#B3FFFFFF}"
                   HorizontalOptions="Center" Margin="0,10,0,0"/>
          </VerticalStackLayout>
        </CollectionView.EmptyView>

      </CollectionView>

    </RefreshView>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ROW 3: Status bar                                   -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Grid Grid.Row="3" HeightRequest="24" ColumnDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}">
      <Label Grid.Column="0" Text="{Binding StatusMessage}"
             Padding="8,0" FontSize="10" TextColor="{AppThemeBinding Light=#B3000000, Dark=#B3FFFFFF}"
             VerticalOptions="Center" HorizontalOptions="Start"/>
      <Label Grid.Column="1" Text="( ) = projected value"
             Padding="8,0" FontSize="11" FontAttributes="Italic"
             VerticalOptions="Center" HorizontalOptions="End"
             TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}" />
    </Grid>

  </Grid>

</ContentPage>
